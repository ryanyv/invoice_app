{
  "name": "pipecal-invoice-pro",
  "version": "2.2.0",
  "description": "Polyethylene Pipes & Fittings Invoice & Pricing System",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development concurrently -k \"vite\" \"electron .\"",
    "electron:pack": "npm run build && electron-builder --dir -c.mac.identity=null",
    "electron:build:mac": "npm run build && electron-builder --mac -c.mac.identity=null",
    "electron:build:win": "npm run build && cross-env ELECTRON_BUILDER_7Z_FILTER=BCJ2 electron-builder --win --x64 --arm64",
    "electron:build": "npm run build && cross-env ELECTRON_BUILDER_7Z_FILTER=BCJ2 electron-builder -c.mac.identity=null"
  },
  "build": {
    "appId": "com.polygharb.pipecal",
    "productName": "Pipecal Pro",
    "toolsets": {
      "nsis": "1.2.1"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null,
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jalaali-js": "^2.0.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  }
}
